node_modules
# package-lock.json is intentionally NOT tracked. npm rewrites it with
# platform-specific content on every install, so tracking it caused students'
# `git pull` to fail with lockfile merge conflicts before they could even run
# the app. CI installs with `npm install` (see .github/workflows/build.yml) and
# `.npmrc` sets package-lock=false so npm never regenerates it.
package-lock.json
dist
out
build
!packages/app/build
release
*.log
*.tsbuildinfo
.DS_Store
Thumbs.db
.env
.env.local
packages/app/src/renderer/dist
# OpenPLC Runtime source — downloaded by the CI workflow before Docker build;
# never committed (large C/C++ build tree). To build locally, run:
#   mkdir -p containers/openplc/openplc-src
#   curl -fsSL https://github.com/thiagoralves/OpenPLC_v3/archive/refs/heads/master.tar.gz \
#     | tar -xz --strip-components=1 -C containers/openplc/openplc-src
containers/openplc/openplc-src/
# Test coverage reports — generated artifacts, not committed.
packages/orchestrator/coverage/
# Dev-mode Export default target — student/custom scenario saves land here,
# never inside the tracked scenarios/ folder itself. See getScenarioExportDir()
# in packages/app/src/main/index.ts.
scenarios/custom/
# Electron/Chromium resource-pack byproduct. Not produced by anything in this
# repo's own scripts, never tracked, but has turned up at the project root for
# at least one student (likely from running a packaged build once) and, being
# untracked, used to permanently trip the "Update OTForge" dirty-tree guard.
resources.pak
# Python bytecode cache — appears if anyone runs `python3 -m py_compile` locally
# against a containers/*/server.py while testing.
__pycache__/
*.pyc
# Sentinel written by the "Update OTForge" button to request a `npm update` on
# the next launch (applied by scripts/apply-pending-update.mjs from `predev`).
# Must stay untracked so it never trips the update handler's own dirty-tree guard.
.otforge-pending-dep-update
# Determinism-check scratch output — raw and trajectory logs written by the
# SIM_SEED verification runs (see the process-sim episode API). Local evidence
# for a one-off comparison between two seeded runs, never a build input.
.simcmp/
# Locally seeded copies of a tracked scenario — a normal .otflab with a
# "simSeed" pinned in it, made by hand to re-run the same lab deterministically.
# The tracked scenario stays authoritative; these variants are personal scratch.
scenarios/*_seeded.otflab
